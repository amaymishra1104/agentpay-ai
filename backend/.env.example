# FastAPI
APP_NAME=AgentPay Backend
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Database (local development defaults to SQLite; production can still override with PostgreSQL)
DATABASE_URL=sqlite:///./agentpay.db

# LLM provider abstraction (do not hardcode provider keys)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Razorpay TEST MODE only
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Security
WEBHOOK_SECRET=
