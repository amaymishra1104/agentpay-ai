def test_inventory_decrement_success():
    products = _load_products()
    product_id = "ur_shoe_001"
    initial_qty = products[product_id].inventory_quantity
    
    # Decrement by 1
    decrement_inventory({product_id: 1})
    
    # Reload and check
    products = _load_products()
    assert products[product_id].inventory_quantity == initial_qty - 1
    
    # Restore
    increment_inventory({product_id: 1})

def test_inventory_decrement_insufficient():
    product_id = "ur_shoe_001"
    products = _load_products()
    current_qty = products[product_id].inventory_quantity
    
    # Try to decrement by more than current quantity
    with pytest.raises(ValueError, match="Insufficient inventory"):
        decrement_inventory({product_id: current_qty + 1})
        
    # Check that quantity is unchanged
    products = _load_products()
    assert products[product_id].inventory_quantity == current_qty

def test_inventory_increment_restores():
    product_id = "ur_shoe_001"
    products = _load_products()
    initial_qty = products[product_id].inventory_quantity
    
    increment_inventory({product_id: 5})
    products = _load_products()
    assert products[product_id].inventory_quantity == initial_qty + 5
    
    # Restore
    decrement_inventory({product_id: 5})

def test_concurrent_mutations_no_lost_updates():
    product_id = "ur_shoe_001"
    products = _load_products()
    initial_qty = products[product_id].inventory_quantity
    
    num_threads = 10
    
    # Ensure we have enough stock initially
    if initial_qty < num_threads:
        increment_inventory({product_id: num_threads - initial_qty})
        initial_qty = num_threads

    def worker(_):
        try:
            decrement_inventory({product_id: 1})
            return True
        except Exception:
            return False

    with ThreadPoolExecutor(max_workers=num_threads) as executor:
        results = list(executor.map(worker, range(num_threads)))
        
    success_count = sum(1 for r in results if r)
    assert success_count == num_threads
    
    # Verify final quantity is exactly initial_qty - num_threads
    products = _load_products()
    assert products[product_id].inventory_quantity == initial_qty - num_threads
    
    # Restore original quantity
    increment_inventory({product_id: num_threads})


def test_competing_decrement_single_stock():
    """
    Given a product with exactly stock=1, two competing decrement operations run concurrently.
    Exactly ONE must succeed, exactly ONE must fail with ValueError, final stock must be 0 (never negative).
    """
    product_id = "ur_shoe_001"
    products = _load_products()
    original_qty = products[product_id].inventory_quantity

    # Temporarily set stock to exactly 1
    with file_lock(LOCK_FILE):
        raw_products = _load_json("products.json")
        for p in raw_products:
            if p["id"] == product_id:
                p["inventory_quantity"] = 1
                p["available"] = True
        _safe_write_json("products.json", raw_products)
        _load_products.cache_clear()

    results = []

    def attempt_purchase(_):
        try:
            decrement_inventory({product_id: 1})
            return ("SUCCESS", None)
        except Exception as exc:
            return ("FAILED", str(exc))

    with ThreadPoolExecutor(max_workers=2) as executor:
        futures = [executor.submit(attempt_purchase, i) for i in range(2)]
        results = [f.result() for f in futures]

    successes = [r for r in results if r[0] == "SUCCESS"]
    failures = [r for r in results if r[0] == "FAILED"]

    assert len(successes) == 1, f"Expected exactly 1 success, got {len(successes)}: {results}"
    assert len(failures) == 1, f"Expected exactly 1 failure, got {len(failures)}: {results}"
    assert "Insufficient inventory" in failures[0][1]

    # Verify final stock is 0 and available is False
    products = _load_products()
    assert products[product_id].inventory_quantity == 0
    assert products[product_id].available is False

    # Restore original quantity
    with file_lock(LOCK_FILE):
        raw_products = _load_json("products.json")
        for p in raw_products:
            if p["id"] == product_id:
                p["inventory_quantity"] = original_qty
                p["available"] = True
        _safe_write_json("products.json", raw_products)
        _load_products.cache_clear()


def _multiprocess_worker(product_id: str) -> tuple[str, str | None]:
    os.environ["DATABASE_URL"] = "sqlite:///./agentpay.db"
    try:
        decrement_inventory({product_id: 1})
        return ("SUCCESS", None)
    except Exception as exc:
        return ("FAILED", str(exc))


def test_stale_lock_recovery_and_cleanup():
    """
    Verifies that a stale lock file (>3 seconds old) is evicted cleanly
    and that exception inside file_lock block releases the lock in finally block.
    """
    from app.services.catalog_service import LOCK_FILE, file_lock
    import time

    # 1. Test exception cleanup in finally block
    try:
        with file_lock(LOCK_FILE):
            raise RuntimeError("Simulated failure inside locked region")
    except RuntimeError:
        pass

    assert not LOCK_FILE.exists(), "Lock file was left behind after exception!"

    # 2. Test stale lock file recovery (> 3 seconds old)
    LOCK_FILE.write_text("999999", encoding="utf-8")
    # Backdate mtime by 5 seconds
    past_time = time.time() - 5.0
    os.utime(LOCK_FILE, (past_time, past_time))

    # file_lock must evict stale lock and acquire successfully
    acquired = False
    with file_lock(LOCK_FILE, timeout=2.0):
        acquired = True

    assert acquired, "Failed to acquire lock after stale lock eviction!"
    assert not LOCK_FILE.exists(), "Lock file was left behind after exit!"


def test_multiprocess_competing_decrement_single_stock():
    """
    Spawns multiple independent OS processes via ProcessPoolExecutor attempting to decrement stock=1 simultaneously.
    Asserts exactly ONE process succeeds, all other processes fail cleanly with ValueError,
    and final stock in products.json is exactly 0.
    """
    from concurrent.futures import ProcessPoolExecutor

    product_id = "ur_shoe_001"
    products = _load_products()
    original_qty = products[product_id].inventory_quantity

    # Temporarily set stock to exactly 1
    with file_lock(LOCK_FILE):
        raw_products = _load_json("products.json")
        for p in raw_products:
            if p["id"] == product_id:
                p["inventory_quantity"] = 1
                p["available"] = True
        _safe_write_json("products.json", raw_products)
        _load_products.cache_clear()

    num_processes = 4
    results = []

    with ProcessPoolExecutor(max_workers=num_processes) as executor:
        futures = [executor.submit(_multiprocess_worker, product_id) for _ in range(num_processes)]
        results = [f.result() for f in futures]

    successes = [r for r in results if r[0] == "SUCCESS"]
    failures = [r for r in results if r[0] == "FAILED"]

    assert len(successes) == 1, f"Expected exactly 1 success, got {len(successes)}: {results}"
    assert len(failures) == num_processes - 1, f"Expected {num_processes - 1} failures, got {len(failures)}: {results}"
    assert all("Insufficient inventory" in f[1] for f in failures)

    # Verify final stock in products.json is 0 and available is False
    products = _load_products()
    assert products[product_id].inventory_quantity == 0
    assert products[product_id].available is False
    assert not LOCK_FILE.exists(), "Lock file left behind after multi-process execution!"

    # Restore original quantity
    with file_lock(LOCK_FILE):
        raw_products = _load_json("products.json")
        for p in raw_products:
            if p["id"] == product_id:
                p["inventory_quantity"] = original_qty
                p["available"] = True
        _safe_write_json("products.json", raw_products)
        _load_products.cache_clear()


def test_checkout_transaction_failure_rollback():
    """
    Simulates a database failure during checkout AFTER inventory has been decremented.
    Verifies that inventory stock is safely restored, products.json.lock is removed,
    and a subsequent checkout attempt without DB error succeeds normally.
    """
    from unittest.mock import patch
    from app.db.database import SessionLocal, init_db
    from app.services import cart_service, checkout_service

    init_db()
    product_id = "ur_shoe_001"
    products_before = _load_products()
    initial_stock = products_before[product_id].inventory_quantity

    with SessionLocal() as db:
        # Create a cart for customer_roll_01
        cart = cart_service.create_cart(merchant_id="m_urbanrun", customer_id="customer_roll_01", db=db)
        cart_service.add_item_to_cart(cart.id, product_id, 1, db, customer_id="customer_roll_01")

        # Mock db.commit to raise an exception during checkout
        with patch.object(db, "commit", side_effect=RuntimeError("Simulated DB commit crash")):
            with pytest.raises(RuntimeError, match="Simulated DB commit crash"):
                checkout_service.checkout_cart(cart.id, "mock_upi", db, customer_id="customer_roll_01")

    # Assert stock was rolled back to initial_stock
    products_after_fail = _load_products()
    assert products_after_fail[product_id].inventory_quantity == initial_stock
    assert not LOCK_FILE.exists(), "Lock file left behind after rollback!"

    # Verify subsequent checkout attempt without DB error succeeds normally
    with SessionLocal() as db:
        order = checkout_service.checkout_cart(cart.id, "mock_upi", db, customer_id="customer_roll_01")
        assert order.order_id is not None
        assert order.status == "placed"

    # Verify inventory was decremented by 1 for successful order and then restored
    products_final = _load_products()
    assert products_final[product_id].inventory_quantity == initial_stock - 1

    # Cleanup: restore inventory and order record
    increment_inventory({product_id: 1})


def test_dead_pid_lock_recovery_and_live_lock_respect():
    """
    1. Simulates a leftover lock from a dead PID (PID 999999, mtime < 3s).
       Verifies a new process/thread recovers safely by removing dead PID lock.
    2. Simulates a live process lock (current PID).
       Verifies competing acquisition times out (TimeoutError) and DOES NOT steal live lock.
    """
    from app.services.catalog_service import LOCK_FILE, file_lock

    # 1. Dead PID lock recovery
    LOCK_FILE.write_text("999999", encoding="utf-8")
    # Leave mtime current (< 3s)
    acquired_dead = False
    with file_lock(LOCK_FILE, timeout=2.0):
        acquired_dead = True
    assert acquired_dead, "Failed to recover lock from dead PID!"
    assert not LOCK_FILE.exists()

    # 2. Live lock protection
    with file_lock(LOCK_FILE, timeout=2.0):
        # Attempt to acquire same lock from another thread while held by live PID
        def competing_acquire():
            # In a thread, _THREAD_LOCK will block. We call file_lock directly without _THREAD_LOCK
            # or test timeout when lock file exists with live PID
            start = time.time()
            try:
                fd = os.open(str(LOCK_FILE), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
                os.close(fd)
                return True
            except FileExistsError:
                return False

        # Attempt to create lock while held
        success = competing_acquire()
        assert not success, "Competing process was able to steal an active lock!"

    assert not LOCK_FILE.exists(), "Lock file left behind!"


def test_timeout_does_not_delete_live_lock_and_leaves_intact():
    import threading
    if LOCK_FILE.exists():
        try:
            LOCK_FILE.unlink()
        except Exception:
            pass

    # Create a live lock file with current PID
    live_pid = os.getpid()
    LOCK_FILE.write_text(str(live_pid), encoding="utf-8")

    result = []
    def worker():
        try:
            with file_lock(LOCK_FILE, timeout=0.2, delay=0.02):
                pass
            result.append("SUCCESS")
        except TimeoutError:
            result.append("TIMEOUT")
        except Exception as e:
            result.append(f"ERROR: {type(e).__name__}")

    t = threading.Thread(target=worker)
    t.start()
    t.join()

    assert result == ["TIMEOUT"]
    assert LOCK_FILE.exists(), "Lock file was deleted on timeout!"
    assert LOCK_FILE.read_text(encoding="utf-8").strip() == str(live_pid)

    # Clean up
    LOCK_FILE.unlink()


def test_focused_stale_lock_recovery():
    if LOCK_FILE.exists():
        try:
            LOCK_FILE.unlink()
        except Exception:
            pass

    # Create a stale lock (PID 999999, mtime backdated by 5s)
    LOCK_FILE.write_text("999999", encoding="utf-8")
    past_time = time.time() - 5.0
    os.utime(LOCK_FILE, (past_time, past_time))

    # Should acquire lock successfully
    acquired = False
    with file_lock(LOCK_FILE, timeout=1.0):
        acquired = True
        # Inside the lock, file should exist and have our own PID
        assert LOCK_FILE.exists()
        assert LOCK_FILE.read_text(encoding="utf-8").strip() == str(os.getpid())

    assert acquired, "Failed to acquire stale lock!"
    assert not LOCK_FILE.exists(), "Lock file was not removed on successful exit!"


def test_successful_acquisition_removes_own_lock():
    if LOCK_FILE.exists():
        try:
            LOCK_FILE.unlink()
        except Exception:
            pass

    acquired = False
    with file_lock(LOCK_FILE, timeout=1.0):
        acquired = True
        assert LOCK_FILE.exists()
        assert LOCK_FILE.read_text(encoding="utf-8").strip() == str(os.getpid())

    assert acquired
    assert not LOCK_FILE.exists()


def test_exception_inside_lock_removes_own_lock():
    if LOCK_FILE.exists():
        try:
            LOCK_FILE.unlink()
        except Exception:
            pass

    with pytest.raises(ValueError, match="Test Exception"):
        with file_lock(LOCK_FILE, timeout=1.0):
            assert LOCK_FILE.exists()
            raise ValueError("Test Exception")

    assert not LOCK_FILE.exists()
